{
  "name": "particle-ocean",
  "version": "0.1.0",
  "private": false,
  "description": "A particle-cloud ocean: 18 sea creatures, each with its own swimming physics, rendered as three.js point clouds.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:site": "tsc --noEmit && BASE=/ocean/ vite build --outDir dist-site"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "author": {
    "name": "Andrey Gurov",
    "url": "https://agurov.com"
  },
  "homepage": "https://agurov.com/ocean/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ekazanec/particle-ocean.git"
  },
  "bugs": {
    "url": "https://github.com/ekazanec/particle-ocean/issues"
  },
  "keywords": [
    "three",
    "threejs",
    "webgl",
    "particles",
    "creature",
    "animation",
    "ocean",
    "point-cloud"
  ]
}
